create_library_set \
    -name slow_lib \
    -timing [list \
        /home/install/FOUNDRY/digital/90nm/dig/lib/slow.lib \
    ]

create_rc_corner \
    -name rc_corner \
    -qx_tech_file /home/install/FOUNDRY/analog/90nm/fireIce/qx/gpdk090_9l.tch

create_delay_corner \
    -name slow_corner \
    -library_set slow_lib \
    -rc_corner rc_corner

create_constraint_mode \
    -name functional \
    -sdc_files [list \
        /home/arshad/Desktop/Arshad/project3/constraints/execution_unit.sdc \
    ]

create_analysis_view \
    -name setup_view \
    -constraint_mode functional \
    -delay_corner slow_corner

set_analysis_view \
    -setup {setup_view} \
    -hold {setup_view}
